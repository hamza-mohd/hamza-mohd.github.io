---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
import profilePhoto from '../images/hamza-mohd.jpg'
import Github from '../components/Icons/Github.astro'
import Xitter from '../components/Icons/Xitter.astro'
import Reddit from '../components/Icons/Reddit.astro'
---

<BaseLayout
  title="Hamza Mohd"
  description="Software engineer at Tata Consultancy Services. Backend, platforms, and the unglamorous parts of distributed systems."
  keywords="hamza mohd, software engineer, backend, platform engineering, golang, javascript, tcs"
>
  <section class="hero">
    <div class="heroText">
      <span class="eyebrow">
        <span class="dot"></span>
        Currently building platforms
      </span>
      <h1 class="display">
        Software engineer<br />working on the<br />
        <span class="grad">hard parts.</span>
      </h1>
      <p class="lede">
        I'm <strong>Hamza</strong>. I build backend systems and developer
        platforms at <a
          href="https://www.tcs.com"
          target="_blank"
          rel="noreferrer noopener">Tata Consultancy Services</a
        >. I write here about API design, databases, observability, and the
        small operational decisions that compound over time.
      </p>
      <div class="ctaRow">
        <a class="cta primary" href="/blog/">Read the blog &rarr;</a>
        <a class="cta ghost" href="/about/">About me</a>
      </div>
      <div class="quickLinks">
        <a
          href="https://github.com/hamza-mohd"
          target="_blank"
          rel="noreferrer noopener"
          aria-label="GitHub"
        >
          <Github />
          <span>github.com/hamza-mohd</span>
        </a>
        <a
          href="https://x.com/MohdHamza190070"
          target="_blank"
          rel="noreferrer noopener"
          aria-label="X (Twitter)"
        >
          <Xitter />
          <span>@MohdHamza190070</span>
        </a>
        <a
          href="https://www.reddit.com/user/ClassicOld2202/"
          target="_blank"
          rel="noreferrer noopener"
          aria-label="Reddit"
        >
          <Reddit />
          <span>u/ClassicOld2202</span>
        </a>
      </div>
    </div>
    <div class="photoFrame">
      <div class="photoGlow" aria-hidden="true"></div>
      <Image
        src={profilePhoto}
        alt="Hamza Mohd"
        quality={85}
        widths={[240, 420, 600]}
        sizes={`(max-width: 480px) 240px,
        (max-width: 720px) 360px,
        420px`}
      />
    </div>
  </section>

  <section class="focusGrid" aria-label="What I work on">
    <h2 class="sectionHeading">What I think about</h2>
    <div class="cards">
      <article class="focusCard">
        <span class="cardIcon" aria-hidden="true">⚙️</span>
        <h3>Backend &amp; APIs</h3>
        <p>
          Contracts that hold up under retries, schemas that survive a year of
          changes, and endpoints that fail in obvious ways.
        </p>
      </article>
      <article class="focusCard">
        <span class="cardIcon" aria-hidden="true">🛠️</span>
        <h3>Platform engineering</h3>
        <p>
          Paved roads, golden paths, and the operator-grade pieces that make
          self-service real instead of aspirational.
        </p>
      </article>
      <article class="focusCard">
        <span class="cardIcon" aria-hidden="true">📊</span>
        <h3>Observability</h3>
        <p>
          Metrics, logs, traces. Knowing which one to reach for, and resisting
          the urge to alert on the wrong signal.
        </p>
      </article>
      <article class="focusCard">
        <span class="cardIcon" aria-hidden="true">🗄️</span>
        <h3>Databases</h3>
        <p>
          Query plans, index shapes, and the production-shaped problems that
          never show up in development.
        </p>
      </article>
    </div>
  </section>

  <section class="ctaCard">
    <div>
      <h2>Reading list</h2>
      <p>
        A handful of recent posts on idempotency, Go concurrency, indexing,
        observability, and flaky tests.
      </p>
    </div>
    <a class="cta primary" href="/blog/">Browse posts &rarr;</a>
  </section>

  <style>
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: center;
      padding: 4rem 0 5rem;
    }

    .heroText {
      display: grid;
      gap: 1.25rem;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      align-self: start;
      font-family: var(--font-display);
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--fg-muted);
      background: var(--accent-soft);
      padding: 0.4rem 0.85rem;
      border-radius: 999px;
      border: 1px solid var(--border);
    }

    .eyebrow .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% {
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18);
      }
      50% {
        box-shadow: 0 0 0 6px rgba(34, 197, 94, 0.08);
      }
    }

    h1.display {
      font-family: var(--font-display);
      font-size: clamp(2rem, 5.5vw, 3.75rem);
      line-height: 1.05;
      letter-spacing: -0.035em;
      font-weight: 700;
      margin: 0.25rem 0 0;
      color: var(--fg);
      -webkit-text-fill-color: var(--fg);
      background: none;
    }

    h1.display .grad {
      background: var(--gradient);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .lede {
      font-size: 1.0625rem;
      color: var(--fg-muted);
      margin: 0.5rem 0 0.5rem;
      max-width: 56ch;
    }

    .lede strong {
      color: var(--fg);
      font-weight: 600;
    }

    .ctaRow {
      display: inline-flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-top: 0.25rem;
    }

    .cta {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 1.15rem;
      border-radius: var(--radius-md);
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 0.95rem;
      text-decoration: none;
      transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
      border: 1px solid transparent;
    }

    .cta.primary {
      background: var(--gradient);
      color: white;
      box-shadow: var(--shadow-md);
    }

    .cta.primary:hover {
      transform: translateY(-1px);
      box-shadow: var(--shadow-lg);
      color: white;
      text-decoration: none;
    }

    .cta.ghost {
      color: var(--fg);
      background: transparent;
      border-color: var(--border-strong);
    }

    .cta.ghost:hover {
      background: var(--accent-soft);
      border-color: var(--accent);
      color: var(--accent);
      text-decoration: none;
    }

    .quickLinks {
      display: grid;
      gap: 0.5rem;
      margin-top: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
    }

    .quickLinks a {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--fg-muted);
      font-size: 0.875rem;
      font-weight: 500;
      width: fit-content;
      transition: color 0.15s ease;
    }

    .quickLinks a :global(svg) {
      width: 16px;
      height: 16px;
      opacity: 0.85;
    }

    .quickLinks a:hover {
      color: var(--accent);
      text-decoration: none;
    }

    .photoFrame {
      position: relative;
      justify-self: end;
      width: 100%;
      max-width: 340px;
      aspect-ratio: 1 / 1;
    }

    .photoGlow {
      position: absolute;
      inset: -12%;
      background: var(--gradient);
      filter: blur(50px);
      opacity: 0.4;
      border-radius: 50%;
      z-index: 0;
    }

    .photoFrame :global(img) {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: var(--radius-xl);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-lg);
    }

    /* Sections */
    .sectionHeading {
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--fg-subtle);
      margin: 0 0 1.25rem;
      background: none;
      -webkit-text-fill-color: var(--fg-subtle);
    }

    .focusGrid {
      padding: 2rem 0 3rem;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }

    .focusCard {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .focusCard:hover {
      transform: translateY(-3px);
      border-color: var(--accent);
      box-shadow: var(--shadow-md);
    }

    .cardIcon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: var(--radius-md);
      background: var(--accent-soft);
      font-size: 1.125rem;
      margin-bottom: 0.5rem;
    }

    .focusCard h3 {
      font-family: var(--font-display);
      font-size: 1.05rem;
      margin: 0.25rem 0 0.5rem;
      color: var(--fg);
    }

    .focusCard p {
      font-size: 0.9rem;
      margin: 0;
      color: var(--fg-muted);
      line-height: 1.55;
    }

    .ctaCard {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
      padding: 2rem;
      margin-top: 1rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
    }

    .ctaCard h2 {
      margin: 0 0 0.25rem;
      font-size: 1.25rem;
    }

    .ctaCard p {
      margin: 0;
      color: var(--fg-muted);
      font-size: 0.95rem;
    }

    @media (max-width: 820px) {
      .hero {
        grid-template-columns: 1fr;
        gap: 3rem;
        padding: 2.5rem 0 3.5rem;
      }
      .photoFrame {
        justify-self: center;
        max-width: 260px;
      }
    }

    @media (max-width: 480px) {
      .ctaCard {
        padding: 1.5rem;
      }
    }
  </style>
</BaseLayout>
