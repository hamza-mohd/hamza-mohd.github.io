---
import readingTime from 'reading-time'

import BaseLayout from '../../layouts/BaseLayout.astro'
import Paginator from '../../components/Paginator.astro'

export async function getStaticPaths({ paginate, rss }) {
  const allPosts = await Astro.glob('./**/*.md')
  const sortedPosts = allPosts.sort(
    (a, b) =>
      new Date(b.frontmatter.publishDate).valueOf() -
      new Date(a.frontmatter.publishDate).valueOf()
  )
  return paginate(sortedPosts, { pageSize: 10 })
}

const { page } = Astro.props

function formatDate(input: string) {
  const d = new Date(input)
  if (isNaN(d.valueOf())) return input
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  })
}
---

<BaseLayout
  title="Blog"
  description="Notes on backend engineering, platforms, databases, observability, and the small operational decisions that compound."
  keywords="blog, software engineering, backend, platforms, databases, observability"
>
  <header class="pageHead">
    <span class="kicker">Writing</span>
    <h1>Blog</h1>
    <p class="sub">
      Mostly on backend systems, platforms, and the parts of distributed
      systems that decide whether anything else works.
    </p>
  </header>

  <div class="articles">
    {
      page.data.map(
        ({
          rawContent,
          url,
          frontmatter: { title, publishDate, description }
        }) => {
          if (url.includes('old-posts')) {
            const oldUrl = url.replace('/blog/old-posts/', '').replace('/blog/')
            const year = oldUrl.slice(0, 4)
            const month = oldUrl.slice(5, 7)
            const day = oldUrl.slice(8, 10)
            const name = oldUrl.slice(11)
            url = `/${year}/${month}/${day}/${name}`
          }
          return (
            <a href={url} class="articleLink">
              <article>
                <div class="meta">
                  <time>{formatDate(publishDate)}</time>
                  <span class="dot">·</span>
                  <span class="rt">{readingTime(rawContent()).text}</span>
                </div>
                <h2>{title}</h2>
                <p class="description">{description}</p>
                <span class="readMore">Read post &rarr;</span>
              </article>
            </a>
          )
        }
      )
    }
  </div>
  <Paginator page={page} />
</BaseLayout>

<style>
  .pageHead {
    margin: 1.5rem 0 2.5rem;
  }

  .kicker {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  .pageHead h1 {
    margin: 0;
  }

  .pageHead .sub {
    color: var(--fg-muted);
    max-width: 60ch;
    margin: 0.75rem 0 0;
    font-size: 1.05rem;
  }

  .articles {
    display: grid;
    gap: 1.25rem;
  }

  .articleLink {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .articleLink:hover {
    text-decoration: none;
  }

  article {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.75rem;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    position: relative;
  }

  .articleLink:hover article {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  article .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--fg-subtle);
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  article .meta .dot {
    opacity: 0.5;
  }

  article h2 {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.25;
    color: var(--fg);
    margin: 0.5rem 0 0.5rem;
    letter-spacing: -0.02em;
  }

  article .description {
    color: var(--fg-muted);
    margin: 0 0 1rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  article .readMore {
    display: inline-block;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 500;
    transition: transform 0.2s ease;
  }

  .articleLink:hover .readMore {
    transform: translateX(3px);
  }

  @media (max-width: 480px) {
    article {
      padding: 1.25rem 1.25rem;
    }
    article h2 {
      font-size: 1.2rem;
    }
  }
</style>
