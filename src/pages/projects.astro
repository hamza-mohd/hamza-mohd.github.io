---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
import 'dotenv/config'
import star from '../images/star.png'

const featuredProjects = [
  {
    name: 'Backstage plugin for the TCS Labs internal developer platform',
    description:
      'Built an internal Backstage plugin to surface service ownership, deployment context, golden paths, and platform workflows in one place for engineering teams.',
    href: '/2026/05/29/building-a-backstage-plugin-for-the-tcs-labs-idp',
    meta: ['Backstage', 'Platform engineering', 'Internal developer platform']
  }
]

const requestBody = `
{
  user(login: "hamza-mohd") {
    pinnedItems(first: 6, types: REPOSITORY) {
      edges {
        node {
            ...on Repository {
              id
            name
            description
            stargazers {
              totalCount
            }
            url
            languages(first: 3) {
              edges {
                node {
                  name
                }
              }
            }
          }
        }
      }
    }
  }
}
`

const ghAccessToken = import.meta.env.GH_ACCESS_TOKEN
let projects = []
if (ghAccessToken) {
  const response = await fetch('https://api.github.com/graphql', {
    method: 'POST',
    headers: { authorization: `Bearer ${ghAccessToken}` },
    body: JSON.stringify({
      query: requestBody
    })
  })

  if (!response.ok) {
    throw new Error(
      `GitHub GraphQL request failed: ${response.status} ${response.statusText}`
    )
  }

  const responseBody = await response.json()
  if (responseBody.errors?.length) {
    throw new Error(
      `GitHub GraphQL request failed: ${responseBody.errors
        .map(({ message }) => message)
        .join(', ')}`
    )
  }

  projects = responseBody.data?.user?.pinnedItems?.edges ?? []
}
---

<BaseLayout
  title="Projects"
  description="A small collection of things I've built or contributed to."
  keywords="projects, github, repositories, open source"
>
  <header class="pageHead">
    <span class="kicker">Building</span>
    <h1>Projects</h1>
    <p class="sub">
      A mix of selected platform work and pinned public repositories. More on <a
        href="https://github.com/hamza-mohd"
        target="_blank"
        rel="noreferrer noopener">my GitHub</a
      >.
    </p>
  </header>

  <section class="sectionBlock">
    <div class="sectionLabel">Selected work</div>
    <div class="project-list">
      {featuredProjects.map(({ name, description, href, meta }) => (
        <a class="cardLink" href={href}>
          <article>
            <header class="cardHeader">
              <h2>{name}</h2>
              <span class="badge">Featured</span>
            </header>
            <p class="description">{description}</p>
            <ul class="languages">
              {meta.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        </a>
      ))}
    </div>
  </section>

  <section class="sectionBlock">
    <div class="sectionLabel">Pinned repositories</div>
  {
    projects.length === 0 ? (
      <div class="empty">
        <p>Pinned projects load from GitHub at build time when GH_ACCESS_TOKEN is set.</p>
      </div>
    ) : (
      <div class="project-list">
        {projects.map(
          ({ node: { url, name, stargazers, description, languages } }) => (
            <a
              class="cardLink"
              href={url}
              target="_blank"
              rel="noreferrer noopener"
            >
              <article>
                <header class="cardHeader">
                  <h2>{name}</h2>
                  <span class="stars" aria-label={`${stargazers.totalCount} stars`}>
                    <Image src={star} alt="" />
                    <span>{stargazers.totalCount}</span>
                  </span>
                </header>
                <p class="description">{description}</p>
                {languages && (
                  <ul class="languages">
                    {languages.edges.map(({ node: { name } }) => (
                      <li>{name}</li>
                    ))}
                  </ul>
                )}
              </article>
            </a>
          )
        )}
      </div>
    )
  }
  </section>
</BaseLayout>

<style>
  .pageHead {
    margin: 1.5rem 0 2.5rem;
  }

  .kicker {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  .pageHead h1 {
    margin: 0;
  }

  .pageHead .sub {
    color: var(--fg-muted);
    max-width: 60ch;
    margin: 0.75rem 0 0;
    font-size: 1.05rem;
  }

  .empty {
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    text-align: center;
    color: var(--fg-subtle);
  }

  .sectionBlock + .sectionBlock {
    margin-top: 2rem;
  }

  .sectionLabel {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    margin-bottom: 1rem;
  }

  .project-list {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .cardLink {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .cardLink:hover {
    text-decoration: none;
  }

  article {
    height: 100%;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .cardLink:hover article {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  .cardHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .cardHeader h2 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--fg);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .stars {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--fg-subtle);
    font-weight: 500;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--border);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .stars :global(img) {
    width: 12px;
    height: 12px;
  }

  .description {
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    flex-grow: 1;
  }

  ul.languages {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  ul.languages li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--fg-muted);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    margin: 0;
  }
</style>
