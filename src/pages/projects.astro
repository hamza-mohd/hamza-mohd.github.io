---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
import 'dotenv/config'
import star from '../images/star.png'

const requestBody = `
{
  user(login: "hamza-mohd") {
    pinnedItems(first: 6, types: REPOSITORY) {
      edges {
        node {
            ...on Repository {
              id
            name
            description
            stargazers {
              totalCount
            }
            url
            languages(first: 3) {
              edges {
                node {
                  name
                }
              }
            }
          }
        }
      }
    }
  }
}
`

let projects = []
if (!process.env.GH_ACCESS_TOKEN || process.env.GH_ACCESS_TOKEN === '') {
  console.error(
    'No GitHub access token found. Please set GH_ACCESS_TOKEN in your environment variables.'
  )
} else {
  const response = await fetch('https://api.github.com/graphql', {
    method: 'POST',
    headers: { authorization: `Bearer ${process.env.GH_ACCESS_TOKEN}` },
    body: JSON.stringify({
      query: requestBody
    })
  }).then((res) => res.json())
  projects = response.data?.user?.pinnedItems?.edges ?? []
}
---

<BaseLayout
  title="Projects"
  description="A small collection of things I've built or contributed to."
  keywords="projects, github, repositories, open source"
>
  <header class="pageHead">
    <span class="kicker">Building</span>
    <h1>Projects</h1>
    <p class="sub">
      A small set of pinned projects. More on <a
        href="https://github.com/hamza-mohd"
        target="_blank"
        rel="noreferrer noopener">my GitHub</a
      >.
    </p>
  </header>

  {
    projects.length === 0 ? (
      <div class="empty">
        <p>Pinned projects load from GitHub at build time.</p>
      </div>
    ) : (
      <div class="project-list">
        {projects.map(
          ({ node: { url, name, stargazers, description, languages } }) => (
            <a
              class="cardLink"
              href={url}
              target="_blank"
              rel="noreferrer noopener"
            >
              <article>
                <header class="cardHeader">
                  <h2>{name}</h2>
                  <span class="stars" aria-label={`${stargazers.totalCount} stars`}>
                    <Image src={star} alt="" />
                    <span>{stargazers.totalCount}</span>
                  </span>
                </header>
                <p class="description">{description}</p>
                {languages && (
                  <ul class="languages">
                    {languages.edges.map(({ node: { name } }) => (
                      <li>{name}</li>
                    ))}
                  </ul>
                )}
              </article>
            </a>
          )
        )}
      </div>
    )
  }
</BaseLayout>

<style>
  .pageHead {
    margin: 1.5rem 0 2.5rem;
  }

  .kicker {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  .pageHead h1 {
    margin: 0;
  }

  .pageHead .sub {
    color: var(--fg-muted);
    max-width: 60ch;
    margin: 0.75rem 0 0;
    font-size: 1.05rem;
  }

  .empty {
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    text-align: center;
    color: var(--fg-subtle);
  }

  .project-list {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .cardLink {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .cardLink:hover {
    text-decoration: none;
  }

  article {
    height: 100%;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .cardLink:hover article {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  .cardHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .cardHeader h2 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--fg);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .stars {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--fg-subtle);
    font-weight: 500;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }

  .stars :global(img) {
    width: 12px;
    height: 12px;
  }

  .description {
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    flex-grow: 1;
  }

  ul.languages {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  ul.languages li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--fg-muted);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    margin: 0;
  }
</style>
