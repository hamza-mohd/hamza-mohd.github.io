---
const currentPath = Astro.url.pathname
import Logo from './Icons/Logo.astro'
import ThemeToggle from './Icons/ThemeToggle.astro'

const isActive = (path: string) =>
  currentPath === path || currentPath.startsWith(path + '/')
---

<header class="mainNav">
  <a href="/" class="logoLink" aria-label="Home">
    <div class="logo">
      <Logo name="Logo" />
    </div>
  </a>
  <button aria-controls="menu" aria-expanded="false" aria-label="Toggle menu"
  ></button>
  <nav>
    <ul>
      <li>
        <a class={isActive('/blog') ? 'active' : ''} href="/blog/">Blog</a>
      </li>
      <li>
        <a class={isActive('/projects') ? 'active' : ''} href="/projects/"
          >Projects</a
        >
      </li>
      <li>
        <a class={isActive('/about') ? 'active' : ''} href="/about/">About</a>
      </li>
      <li>
        <a class={isActive('/uses') ? 'active' : ''} href="/uses/">Uses</a>
      </li>
      <li>
        <a
          class={isActive('/stream-tools') ? 'active' : ''}
          href="/stream-tools/">Stream tools</a
        >
      </li>
    </ul>
  </nav>
  <ThemeToggle />
</header>

<style>
  header {
    background-color: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid transparent;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    padding: 1rem 1.5rem;
    position: sticky;
    max-width: var(--wide-width);
    margin: 0 auto;
    top: 0;
    z-index: 50;
    transition: padding 0.3s ease, border-color 0.3s ease, background-color 0.3s ease;
  }

  header.shrink {
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 1.5rem;
  }

  .logoLink {
    display: inline-flex;
    align-items: center;
    height: 40px;
    width: 40px;
    border-radius: var(--radius-md);
    transition: transform 0.2s ease;
  }

  .logoLink:hover {
    transform: scale(1.05);
  }

  button[aria-expanded] {
    display: none;
  }

  nav ul {
    display: flex;
    list-style: none;
    justify-content: end;
    align-items: center;
    padding: 0;
    margin: 0;
    gap: 0.25rem;
  }

  nav li {
    margin: 0;
  }

  nav li a,
  nav li a:visited {
    display: inline-block;
    color: var(--fg-muted);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  nav li a:hover,
  nav li a:focus {
    color: var(--fg);
    background: var(--accent-soft);
    text-decoration: none;
  }

  nav li a.active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  @media (max-width: 565px) {
    header {
      grid-template-columns: 36px 1fr auto;
      gap: 0.75rem;
      padding: 0.75rem 1.25rem;
    }

    button[aria-expanded] {
      background: none;
      border: none;
      cursor: pointer;
      display: inline-block;
      height: 28px;
      margin-left: auto;
      outline: none;
      padding: 0;
      position: relative;
      width: 28px;
      order: 3;
    }

    button[aria-expanded]:before,
    button[aria-expanded]:after {
      background: var(--fg);
      content: '';
      height: 2px;
      left: 4px;
      right: 4px;
      position: absolute;
      transition: transform 0.25s ease, top 0.25s ease, bottom 0.25s ease;
      border-radius: 2px;
    }

    button[aria-expanded='false']:before {
      top: 9px;
    }

    button[aria-expanded='false']:after {
      bottom: 9px;
    }

    button[aria-expanded='true']:before {
      top: 13px;
      transform: rotate(45deg);
    }

    button[aria-expanded='true']:after {
      bottom: 13px;
      transform: rotate(-45deg);
    }

    nav {
      order: 4;
      grid-column: 1 / -1;
      display: grid;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s ease;
    }

    nav ul {
      display: grid;
      gap: 0.25rem;
      justify-content: stretch;
      margin: 0;
      padding: 1rem 0 0.5rem;
      width: 100%;
    }

    nav ul li a,
    nav ul li a:visited {
      display: block;
      text-align: center;
      padding: 0.75rem;
    }

    [aria-expanded='true'] ~ nav {
      max-height: 320px;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const navButtons = [...document.querySelectorAll('button[aria-expanded]')]
    const header: Element | null = document.querySelector('.mainNav')

    function toggleNav(this: HTMLElement) {
      const expanded = this.getAttribute('aria-expanded') === 'true'
      this.setAttribute('aria-expanded', String(!expanded))
    }

    navButtons.forEach((button) => {
      button.addEventListener('click', toggleNav)
    })

    function handleScroll() {
      const shouldShrink = window.scrollY > 8
      header?.classList.toggle('shrink', shouldShrink)
    }

    window.addEventListener('scroll', handleScroll, { passive: true })
    handleScroll()
  })
</script>
