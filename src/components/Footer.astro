---
const year = new Date().getFullYear()
import Rss from './Icons/Rss.astro'
import Xitter from './Icons/Xitter.astro'
import Github from './Icons/Github.astro'
import Reddit from './Icons/Reddit.astro'
---

<footer>
  <div class="meta">
    <span class="copy">© {year} Hamza Mohd</span>
    <span class="dot" aria-hidden="true">·</span>
    <a href="https://astro.build" target="_blank" rel="noreferrer noopener"
      >Built with Astro</a
    >
  </div>
  <div class="socials" aria-label="Social links">
    <a
      class="iconLink"
      href="https://github.com/hamza-mohd"
      target="_blank"
      rel="noreferrer noopener"
      aria-label="GitHub"
      title="GitHub"
    >
      <Github />
    </a>
    <a
      class="iconLink"
      href="https://x.com/mohdhamza_x"
      target="_blank"
      rel="noreferrer noopener"
      aria-label="X (Twitter)"
      title="X (Twitter)"
    >
      <Xitter />
    </a>
    <a
      class="iconLink"
      href="https://www.reddit.com/user/ClassicOld2202/"
      target="_blank"
      rel="noreferrer noopener"
      aria-label="Reddit"
      title="Reddit"
    >
      <Reddit />
    </a>
    <a class="iconLink" href="/rss.xml" aria-label="RSS feed" title="RSS feed">
      <Rss />
    </a>
  </div>
</footer>

<style>
  footer {
    align-items: center;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 3rem 0 1rem;
    margin-top: 4rem;
    border-top: 1px solid var(--border);
  }

  .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--fg-subtle);
  }

  .meta .dot {
    color: var(--fg-subtle);
    opacity: 0.6;
  }

  .meta a {
    color: var(--fg-muted);
    font-weight: 500;
  }

  .meta a:hover {
    color: var(--accent);
  }

  .socials {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .iconLink {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    color: var(--fg-muted);
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .iconLink:hover {
    background: var(--accent-soft);
    transform: translateY(-2px);
  }

  .iconLink :global(svg) {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 480px) {
    footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>
